# --- دیتابیس مشترک (فروشگاه + پنل) ---
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/mobiler_db?retryWrites=true&w=majority

# --- ورود به پنل مدیریت (/admin) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-strong-password
# رشته‌ی تصادفی حداقل ۳۲ کاراکتر (برای نشست مدیر و مشتری)؛ برای ساخت:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- آدرس نهایی سایت (برای sitemap و اشتراک‌گذاری) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- شبیه‌ساز درگاه پرداخت (پیش‌فرض روشن). برای خاموش‌کردن در محیط واقعی: off
# PAYMENT_SIMULATOR=off

# --- کد تأیید موبایل (پیامک) ---
# پیش‌فرض: شبیه‌ساز (کد در پاسخ API و لاگ سرور نشان داده می‌شود). در محیط production برای فعال‌ماندن شبیه‌ساز: on
# OTP_SIMULATOR=on
# برای سرویس پیامک واقعی یک provider در src/lib/sms.js اضافه کنید و نامش را اینجا بگذارید:
# SMS_PROVIDER=
# کلید HMAC برای کد ملی (اختیاری؛ پیش‌فرض SESSION_SECRET). بعد از تعیین، تغییرش کدهای ملی ثبت‌شده را نامعتبر می‌کند.
# DATA_ENCRYPTION_KEY=

# --- محدودکننده‌ی درخواست مشترک برای Vercel (اختیاری ولی توصیه‌شده) ---
# بدون این دو مقدار، در هر نمونه‌ی سرور محدودکننده‌ی حافظه‌ای استفاده می‌شود.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
